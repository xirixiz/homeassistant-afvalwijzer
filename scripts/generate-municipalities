#!/usr/bin/env python3
"""Generate the municipality -> collector table used by the config flow.

The test addresses in tests/test_data.py hold one known-working address per
municipality, together with the collector that serves it. This script looks up
the municipality of each postal code (PDOK Locatieserver) and writes the result
to custom_components/afvalwijzer/const/municipalities.py.

Usage:
  python3 scripts/generate-municipalities

Postal codes that PDOK can't resolve (e.g. Belgian ones for RecycleApp) are skipped.
"""

from concurrent.futures import ThreadPoolExecutor
import json
from pathlib import Path
import re
import sys
from urllib.parse import urlencode
from urllib.request import urlopen

ROOT = Path(__file__).resolve().parent.parent
TEST_DATA = ROOT / "tests" / "test_data.py"
OUTPUT = ROOT / "custom_components" / "afvalwijzer" / "const" / "municipalities.py"
PDOK_URL = "https://api.pdok.nl/bzk/locatieserver/search/v3_1/free"

# Commented-out test addresses count too: they are still known-good addresses.
ADDRESS_RE = re.compile(r'\{"provider":\s*"([^"]+)",\s*"postal_code":\s*"([^"]+)"')


def lookup_municipality(postal_code: str) -> tuple[str, str | None]:
    """Return the municipality name of a postal code, or None if unknown."""
    query = urlencode({"q": f"postcode:{postal_code}", "fl": "gemeentenaam", "rows": 1})
    for _ in range(3):
        try:
            with urlopen(f"{PDOK_URL}?{query}", timeout=30) as response:  # noqa: S310
                docs = json.load(response)["response"]["docs"]
            return postal_code, (docs[0]["gemeentenaam"] if docs else None)
        except (OSError, ValueError, KeyError):
            continue
    return postal_code, None


def sort_key(name: str) -> str:
    """Sort ignoring a leading apostrophe and case ('s-Gravenhage under G)."""
    return name.lstrip("'").casefold()


def main() -> int:
    """Build and write the table."""
    rows = ADDRESS_RE.findall(TEST_DATA.read_text(encoding="utf-8"))
    postal_codes = sorted({code.replace(" ", "").upper() for _, code in rows})

    with ThreadPoolExecutor(max_workers=8) as pool:
        municipality_of = dict(pool.map(lookup_municipality, postal_codes))

    table: dict[str, set[str]] = {}
    for collector, code in rows:
        municipality = municipality_of.get(code.replace(" ", "").upper())
        if municipality:
            table.setdefault(municipality, set()).add(collector)

    ambiguous = {name: sorted(c) for name, c in table.items() if len(c) > 1}
    if ambiguous:
        print(f"Municipalities with more than one collector: {ambiguous}")
        return 1

    lines = [
        '"""Municipality to collector table for the config flow.',
        "",
        "Generated by scripts/generate-municipalities from tests/test_data.py, do not edit.",
        '"""',
        "",
        "MUNICIPALITY_COLLECTORS = {",
    ]
    for name in sorted(table, key=sort_key):
        (collector,) = table[name]
        lines.append(f"    {name!r}: {collector!r},")
    lines.append("}")
    OUTPUT.write_text("\n".join(lines) + "\n", encoding="utf-8")

    unresolved = [code for code, name in municipality_of.items() if not name]
    print(f"Wrote {len(table)} municipalities to {OUTPUT.relative_to(ROOT)}")
    if unresolved:
        print(f"Skipped postal codes without a municipality: {unresolved}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
